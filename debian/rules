#!/usr/bin/make -f
# Build using debhelper's dh sequencer. compat 13 runs dh_autoreconf by default,
# so configure.ac (which uses m4_esyscmd_s for its version) is re-bootstrapped
# during the build.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static

# Drop libtool .la files; Debian policy says not to ship them.
override_dh_auto_install:
	dh_auto_install
	find debian/tmp -name '*.la' -delete

# altfs.service only acts on "stop", which unmounts every LTFS volume.
# Enable and start it on installation, but never stop or restart it on a
# package upgrade: that would unmount the user's tapes.
override_dh_installsystemd:
	dh_installsystemd --no-stop-on-upgrade

override_dh_auto_clean:
	dh_auto_clean
	rm -f altfs.pc
